# =========================
# APP / Spring Boot
# =========================
APP_NAME=rs-management4
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# =========================
# POSTGRES / DATABASE
# =========================
# Nếu chạy DB bằng docker compose thì POSTGRES_HOST=db
# Nếu chạy DB cục bộ (local postgres) thì để localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rs_management_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mypassword

ES_HOST=localhost
ES_PORT=9201
ES_USERNAME=elastic
ES_PASSWORD=ytcj+d8OzXWcawHSxMs0

# =========================
# PGADMIN (tùy chọn)
# =========================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# =========================
# JAVA / JVM (tùy chọn khi chạy container app)
# =========================
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# =========================
# SECURITY / JWT
# =========================
RS_SECURITY_JWT_EXPIRATION=1800
RS_SECURITY_JWT_REFRESH_EXPIRATION=3000

# =========================
# NOTES
# =========================
# 1) Đây là file mẫu (.env.example) -> copy ra .env và chỉnh trước khi dùng
